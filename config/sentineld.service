[Unit]
Description=Sentinel-RS Headless Linux HIPS/EDR Daemon
Documentation=https://github.com/woifik560/sentinel-rs
After=network.target network-pre.target local-fs.target
Before=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/sentineld --config /etc/sentinel/config.toml --rules /etc/sentinel/rules.toml
ExecStopPost=-/usr/sbin/nft delete table inet sentinel
Restart=always
RestartSec=3s
WatchdogSec=15s

# -------------------------------------------------------------
# Systemd Managed Paths
# -------------------------------------------------------------
RuntimeDirectory=sentinel
StateDirectory=sentinel
ConfigurationDirectory=sentinel
LogsDirectory=sentinel

# -------------------------------------------------------------
# Privilege Separation & Linux Capabilities Minimization (TASK-P0-09)
# Dropped CAP_SYS_ADMIN and CAP_SYS_PTRACE; minimized to least privilege
# -------------------------------------------------------------
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_KILL CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_KILL CAP_DAC_READ_SEARCH

# -------------------------------------------------------------
# OS & Process Hardening Directives
# -------------------------------------------------------------
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/sentinel /var/lib/sentinel -/var/log/sentinel /tmp -/sys/kernel/tracing -/sys/kernel/debug/tracing
PrivateTmp=yes
LockPersonality=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
NoNewPrivileges=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectClock=yes
SystemCallFilter=@system-service @network-io bpf @signal fanotify_init fanotify_mark
SystemCallErrorNumber=EPERM

# -------------------------------------------------------------
# OOM Killer & DoS Protection
# -------------------------------------------------------------
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
