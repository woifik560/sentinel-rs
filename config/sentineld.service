[Unit]
Description=Sentinel-RS Headless Linux HIPS/EDR Daemon
Documentation=https://github.com/woifik560/sentinel-rs
After=network.target network-pre.target local-fs.target
Before=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/sentineld --config /etc/sentinel/config.toml --rules /etc/sentinel/rules.toml
ExecStopPost=-/usr/sbin/nft delete table inet sentinel
Restart=always
RestartSec=5s
WatchdogSec=10s

# -------------------------------------------------------------
# Systemd Managed Paths
# -------------------------------------------------------------
RuntimeDirectory=sentinel
StateDirectory=sentinel
ConfigurationDirectory=sentinel

# -------------------------------------------------------------
# Privilege Separation & Linux Capabilities Minimization
# -------------------------------------------------------------
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_KILL
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_KILL

# -------------------------------------------------------------
# OS & Process Hardening Directives
# -------------------------------------------------------------
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/sentinel /var/lib/sentinel /tmp
PrivateTmp=yes
LockPersonality=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectClock=yes
SystemCallFilter=@system-service @network-io @bpf @signal
SystemCallErrorNumber=EPERM

# -------------------------------------------------------------
# OOM Killer & DoS Protection
# -------------------------------------------------------------
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
